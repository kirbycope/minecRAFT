# The interaction box over the post is what is used (to throw) and hit (to destroy), and it is wide enough to cover
# the anchor beside it too. The anchor is drawn by block
# displays riding an invisible frog, because a lead can only be tied to a mob: the frog is leashed to the post,
# which makes the game hang a knot on it.
$summon minecraft:interaction ~ ~ ~ {Tags:["raft.anchor","raft.post"],width:1.5f,height:1.3f,response:1b,Rotation:[$(yaw)f,0f]}
$execute rotated $(yaw) 0 positioned ^ ^ ^0.7 run summon minecraft:frog ~ ~0.15 ~ {Tags:["raft.anchor","raft.carrier"],NoAI:1b,NoGravity:1b,Silent:1b,Invulnerable:1b,PersistenceRequired:1b,Rotation:[$(yaw)f,0f],active_effects:[{id:"minecraft:invisibility",duration:-1,amplifier:0b,show_particles:0b,show_icon:0b}],leash:[I;$(x),$(y),$(z)],Passengers:[{id:"minecraft:block_display",Tags:["raft.anchor"],Rotation:[$(yaw)f,0f],block_state:{Name:"minecraft:netherite_block"},transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[-0.035f,-0.5f,-0.035f],scale:[0.07f,0.56f,0.07f]}},{id:"minecraft:block_display",Tags:["raft.anchor"],Rotation:[$(yaw)f,0f],block_state:{Name:"minecraft:netherite_block"},transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[-0.16f,-0.08f,-0.03f],scale:[0.32f,0.06f,0.06f]}},{id:"minecraft:block_display",Tags:["raft.anchor"],Rotation:[$(yaw)f,0f],block_state:{Name:"minecraft:netherite_block"},transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[-0.06f,0.06f,-0.02f],scale:[0.12f,0.1f,0.04f]}},{id:"minecraft:block_display",Tags:["raft.anchor"],Rotation:[$(yaw)f,0f],block_state:{Name:"minecraft:netherite_block"},transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[-0.24f,-0.5f,-0.035f],scale:[0.48f,0.07f,0.07f]}},{id:"minecraft:block_display",Tags:["raft.anchor"],Rotation:[$(yaw)f,0f],block_state:{Name:"minecraft:netherite_block"},transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[-0.24f,-0.5f,-0.035f],scale:[0.07f,0.2f,0.07f]}},{id:"minecraft:block_display",Tags:["raft.anchor"],Rotation:[$(yaw)f,0f],block_state:{Name:"minecraft:netherite_block"},transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[0.17f,-0.5f,-0.035f],scale:[0.07f,0.2f,0.07f]}}]}

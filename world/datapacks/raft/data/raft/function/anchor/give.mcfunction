# Raft's Throwable Anchor: an oak fence post with the anchor's name, a heavy core's look and a mark of its own.
#   function raft:anchor/give
give @s minecraft:oak_fence[minecraft:item_name="Throwable Anchor",minecraft:lore=[{text:"Set it down on the raft, then use the post to throw it.",color:"gray",italic:false},{text:"Used once: breaking the post destroys it.",color:"gray",italic:false}],minecraft:item_model="minecraft:heavy_core",minecraft:max_stack_size=5,minecraft:custom_data={raft_anchor:true}]
